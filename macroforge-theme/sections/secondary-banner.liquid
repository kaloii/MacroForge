<div class="mf-sec-banner-wrapper">
  <div class="mf-sec-banner-container">
    {% if section.settings.image != blank %}
      <div class="mf-sec-banner-media">
        <img src="{{ section.settings.image | image_url: width: 1200 }}"
             alt="{{ section.settings.heading | escape }}"
             width="{{ section.settings.image.width }}"
             height="{{ section.settings.image.height }}"
             class="mf-sec-banner-img"
             loading="lazy">
      </div>
    {% endif %}

    <div class="mf-sec-banner-content">
      <span class="mf-sec-banner-badge">{{ section.settings.badge | escape }}</span>
      <h2 class="mf-sec-banner-title">{{ section.settings.heading }}</h2>
      <p class="mf-sec-banner-text">{{ section.settings.description }}</p>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="mf-sec-banner-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .mf-sec-banner-wrapper {
    background-color: #310A31;
    padding: 40px 20px;
    border-top: 1px solid #847996;
    border-bottom: 1px solid #847996;
  }
  .mf-sec-banner-container {
    max-width: 1200px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(241, 91, 181, 0.12) 0%, rgba(49, 10, 49, 0.8) 100%);
    border: 2px solid #F15BB5;
    border-radius: 12px;
    padding: 48px 32px;
    display: flex;
    align-items: center;
    gap: 40px;
    box-shadow: 0 0 20px rgba(241, 91, 181, 0.15);
  }
  .mf-sec-banner-media {
    flex: 1 1 45%;
    max-height: 320px;
    border-radius: 8px;
    overflow: hidden;
  }
  .mf-sec-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mf-sec-banner-content {
    flex: 1 1 55%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .mf-sec-banner-badge {
    background-color: #F15BB5;
    color: #310A31;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .mf-sec-banner-title {
    color: #FDF0D5;
    font-size: 2rem;
    font-weight: 900;
    margin: 0 0 12px 0;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .mf-sec-banner-text {
    color: #847996;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 24px 0;
  }
  .mf-sec-banner-btn {
    display: inline-block;
    background-color: transparent;
    color: #FDF0D5;
    border: 2px solid #FDF0D5;
    padding: 12px 28px;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 4px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.25s ease;
  }
  .mf-sec-banner-btn:hover {
    background-color: #FDF0D5;
    color: #310A31;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .mf-sec-banner-container {
      flex-direction: column;
      padding: 30px 20px;
    }
    .mf-sec-banner-media,
    .mf-sec-banner-content {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Secondary Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "HYBRID OFFER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUNDLE HARDWARE WITH FUEL"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to any monthly meal plan and get 20% off all custom MACROFORGE lifting gear."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "CLAIM YOUR DISCOUNT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image"
    }
  ],
  "presets": [
    {
      "name": "Secondary Promo Banner"
    }
  ]
}
{% endschema %}